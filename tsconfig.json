{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "strict": true,

    "noEmit": true,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    "skipLibCheck": true,

    "types": ["./worker-configuration.d.ts"],
  },

  "include": ["src/**/*.ts", "lib/**/*.ts", "worker-configuration.d.ts"],

  "exclude": ["node_modules", ".wrangler"],
}
