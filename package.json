{
  "name": "oracleiptv.waranas",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "main": "./main.index.ts",
  "types": "./main.index.ts",
  "scripts": {
    "dev": "npm run cf:typegen && wrangler dev",
